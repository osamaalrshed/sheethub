REM Copy this file to .env and replace each CHANGE_ME_*.

REM ── PostgreSQL ───────────────────────────────────────────────
set POSTGRES_SUPERUSER=postgres
set POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_pg_super_pass
set POSTGRES_PORT=5432

set POSTGRES_NOCODB_USER=nocodb_user
set POSTGRES_NOCODB_PASSWORD=CHANGE_ME_nocodb_pg_pass

set ETL_READER_USER=etl_reader
set ETL_READER_PASSWORD=CHANGE_ME_etl_reader_pass

REM ── NocoDB ──────────────────────────────────────────────────
set NOCODB_PORT=8181
set NC_PORT_INTERNAL=8080
set NC_AUTH_JWT_SECRET=CHANGE_ME_random_32_chars_or_more
set NC_ADMIN_EMAIL=admin@nocodb.local
set NC_ADMIN_PASSWORD=CHANGE_ME_Admin1!

REM ── ClickHouse (the existing one on this laptop) ────────────
set CH_HOST=localhost
set CH_PORT=8123
set CH_USER=default
set CH_PASSWORD=
set CH_DATABASE=default
