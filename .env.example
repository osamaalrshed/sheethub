# ────────────────────────────────────────────────────────────────────────────
# SheetsHub environment configuration.
#
#   1. Copy:  cp .env.example .env
#   2. Replace every CHANGE_ME_ value.
#   3. Generate strong passwords:  openssl rand -hex 16
#   4. NEVER commit .env.
# ────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# Superuser — used only during container init scripts.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_pg_super_pass
POSTGRES_PORT=5432

# Application user — NocoDB connects as this (full DML on the two DBs).
POSTGRES_NOCODB_USER=nocodb_user
POSTGRES_NOCODB_PASSWORD=CHANGE_ME_nocodb_pg_pass

# Read-only ETL user — for BI tools / direct analytics queries.
ETL_READER_USER=etl_reader
ETL_READER_PASSWORD=CHANGE_ME_etl_reader_pass

# ── NocoDB ─────────────────────────────────────────────────────────────────
NOCODB_PORT=8080
# Public URL users access (used for absolute URLs in NocoDB — e.g. exports).
# No trailing slash. For local: http://localhost:8080
# For production:                 https://sheetshub.yourcompany.com
NC_PUBLIC_URL=http://localhost:8080

# JWT secret — long random string (≥ 32 chars).
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
NC_AUTH_JWT_SECRET=CHANGE_ME_long_random_jwt_secret_at_least_32_chars

# Admin account — created automatically on first NocoDB start.
# Password: 8+ chars, uppercase, number, special character.
NC_ADMIN_EMAIL=admin@sheetshub.local
NC_ADMIN_PASSWORD=CHANGE_ME_Admin1!

# ── ClickHouse (sync target) ───────────────────────────────────────────────
# If CH runs outside this compose, set CH_HOST to its hostname/IP.
# For ClickHouse on the same host (Docker Desktop): set CH_HOST=host.docker.internal
# and uncomment the extra_hosts block in docker-compose.yml.
CH_HOST=clickhouse.internal
CH_PORT=8123
CH_USER=default
CH_PASSWORD=
CH_DATABASE=default

# How often the sync service polls audit.change_log (seconds). Default 3s
# gives near-real-time replication. Bump to 1800 to restore 30-min batches.
SYNC_INTERVAL_SECONDS=3

# ── Setup-script values (only used by setup/setup_nocodb.py) ──────────────
# Shared password for the test users it creates.
TEST_USER_PASSWORD=CHANGE_ME_TestUser1!
NOCODB_URL=http://localhost:8080
PG_HOST_FROM_NOCODB=postgres
