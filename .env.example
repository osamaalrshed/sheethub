# ============================================================
# NocoDB Business Inputs POC — Environment Variables
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Replace every CHANGE_ME_* value with a real secret.
# 3. NEVER commit .env to git.
# ============================================================

# ── PostgreSQL superuser (used only during container init) ──
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_pg_super_pass
POSTGRES_PORT=5432

# ── NocoDB app user (full DML on nocodb_meta + business_inputs) ──
POSTGRES_NOCODB_USER=nocodb_user
POSTGRES_NOCODB_PASSWORD=CHANGE_ME_nocodb_pg_pass

# ── ETL read-only user (SELECT on business_inputs schemas) ──
# Kept here for future sync use; also safe to use for direct read-only queries.
ETL_READER_USER=etl_reader
ETL_READER_PASSWORD=CHANGE_ME_etl_reader_pass

# ── NocoDB application ──────────────────────────────────────
NOCODB_PORT=8080
# Must be a long random string (32+ chars). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
NC_AUTH_JWT_SECRET=CHANGE_ME_long_random_jwt_secret_at_least_32_chars

# Admin account — created automatically on first start.
# Password rules: 8+ chars, uppercase, number, special character.
NC_ADMIN_EMAIL=admin@nocodb.local
NC_ADMIN_PASSWORD=CHANGE_ME_Admin1!

# ── Test users (created by setup/setup_nocodb.py) ───────────
# Same password is set for finance@test.local, sales@test.local, ops@test.local
# Password rules: same as NocoDB admin.
TEST_USER_PASSWORD=CHANGE_ME_TestUser1!

# ── Setup script target (override if NocoDB runs on a different host/port) ──
NOCODB_URL=http://localhost:8080
# Hostname NocoDB uses to reach PostgreSQL (service name inside Docker)
PG_HOST_FROM_NOCODB=postgres
